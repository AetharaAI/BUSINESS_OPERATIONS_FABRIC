# VoiceOps API base URL (no trailing slash)
VOICEOPS_API_BASE_URL=https://voice.aetherpro.us
# Public portal base URL used for invite/reset links in admin responses
# Example: https://voice.syndicateai.co
PORTAL_PUBLIC_BASE_URL=

# Cookie security in production should stay true
PORTAL_COOKIE_SECURE=false

# Internal admin onboarding routes (server-side only)
VOICEOPS_PLATFORM_ADMIN_KEY=
PORTAL_INVITE_TOKEN_SECRET=
# Optional additive workforce directory overlay for delegated internal users.
# Example:
# PORTAL_WORKFORCE_DIRECTORY_JSON=[{"email":"sundaepromix@gmail.com","handle":"sundaepromix","workforce_role":"internal_sales_rep"}]
PORTAL_WORKFORCE_DIRECTORY_JSON=
BOF_WORKSPACE_ID=
BOF_TENANT_ID=
WORKFORCE_DEFAULT_OPERATOR_EMAIL=
WORKFORCE_W8BEN_FORM_URL=https://www.irs.gov/pub/irs-pdf/fw8ben.pdf
WORKFORCE_STORAGE_MODE=memory
WORKFORCE_STORAGE_BUCKET=
WORKFORCE_STORAGE_REGION=
WORKFORCE_STORAGE_ENDPOINT=
WORKFORCE_STORAGE_ACCESS_KEY_ID=
WORKFORCE_STORAGE_SECRET_ACCESS_KEY=
WORKFORCE_STORAGE_FORCE_PATH_STYLE=false
WORKFORCE_INVITE_DELIVERY_MODE=email
REDWATCH_CLIENT_MODE=memory
REDWATCH_SERVICE_BASE_URL=
REDWATCH_API_KEY_HEADER_NAME=x-rw-api-key
REDWATCH_API_KEY=
# Optional route overrides when the live service does not expose the default canonical paths.
# Defaults:
# REDWATCH_EMIT_EVENT_PATH=/api/redwatch/events
# REDWATCH_EMIT_RECEIPT_SYNC_PATH=/api/redwatch/receipts/sync
# REDWATCH_ATTACH_EVIDENCE_PATH=/api/redwatch/evidence/attach
# REDWATCH_QUERY_RECEIPT_PATH=/api/redwatch/receipts/{receiptId}
# REDWATCH_VERIFY_CHAIN_PATH=/api/redwatch/chains/{chainId}/verify
REDWATCH_EMIT_EVENT_PATH=
REDWATCH_EMIT_RECEIPT_SYNC_PATH=
REDWATCH_ATTACH_EVIDENCE_PATH=
REDWATCH_QUERY_RECEIPT_PATH=
REDWATCH_VERIFY_CHAIN_PATH=

# First-login password reset endpoint path on VoiceOps
# Example: /api/v1/auth/change-password
VOICEOPS_PASSWORD_RESET_PATH=

# BOF CRM data plane
# Host-side local runtime may use 127.0.0.1 when Postgres is loopback-published.
# Container-attached runtime should prefer the aether-infra service name.
CRM_DATABASE_URL=
PANDADOC_MODE=stub
PANDADOC_API_BASE_URL=https://api.pandadoc.com/public/v1
PANDADOC_API_KEY=
PANDADOC_WEBHOOK_SECRET=

# Billing scaffold
PORTAL_BILLING_PROVIDER=stripe
# Example: https://billing.your-provider.com/customer/{tenant_id}
PORTAL_BILLING_MANAGE_URL_TEMPLATE=
PORTAL_AI_WEBSITE_OFFER_LABEL=AI Website Wedge
PORTAL_AI_WEBSITE_BUILD_PRICE_CENTS=19700
PORTAL_AI_WEBSITE_MONTHLY_PRICE_CENTS=19700
PORTAL_AI_WEBSITE_BUILD_STRIPE_PRICE_ID=
PORTAL_AI_WEBSITE_MONTHLY_STRIPE_PRICE_ID=
PORTAL_AI_WEBSITE_BUILD_PAYMENT_LINK=
PORTAL_AI_WEBSITE_MONTHLY_PAYMENT_LINK=
PORTAL_AI_WEBSITE_PROMO_NOTE=

# Stripe webhook ingestion
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
